extends layout
block content
  section.container.section
    .heading
      div
        p.eyebrow DATABASE-POWERED PROTOTYPE
        h1 Tour proposals
        p.muted These records are loaded from MySQL through Express and Pug.
    if trips.length
      .cards
        each trip in trips
          article.card
            .card-top
              span.pill= trip.status
              span.muted= trip.destination
            h2= trip.title
            p Traveller: #{trip.traveller_name}
            p.muted #{new Date(trip.start_date).toLocaleDateString('en-GB')} — #{new Date(trip.end_date).toLocaleDateString('en-GB')}
            p.price £#{Number(trip.estimated_total).toFixed(2)} estimated
            a.button(href='/trips/' + trip.id) View itinerary
    else
      .empty No trips found. Run the SQL seed script to add demonstration data.

extends layout
block content
  section.hero
    .container
      p.eyebrow AGENT-ASSISTED TRAVEL PLANNING
      h1 Discover your next journey
      p.lead Explore curated itineraries prepared by human travel agents. Review destinations, activities and indicative costs.
      a.button(href="/trips") Explore trips
  section.container.section
    h2 How TravelMate works
    .cards
      article.card
        h3 01 · Agent plans
        p An agent prepares a tailored itinerary.
      article.card
        h3 02 · Traveller reviews
        p Travellers examine plans and request changes.
      article.card
        h3 03 · Agent approves
        p Human agents approve after traveller confirmation.

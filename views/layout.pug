doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    meta(name="description" content="TravelMate agent-assisted travel planning")
    title #{title} | TravelMate
    link(rel="stylesheet" href="/css/style.css")
  body
    header.site-header
      .container.nav
        a.brand(href="/") ✈ TravelMate
        nav(aria-label="Main navigation")
          a(href="/") Home
          a(href="/trips") Trips
    main
      block content
    footer.footer
      .container TravelMate · Avengers Assemble · Software Development 2 · Prototype — no bookings or payments
